# Salin menjadi .env, lalu isi. Bun membaca .env sendiri.

# Server Freedom Finger (tempat mesin mengirim absen).
FREEDOM_FINGER_URL=http://localhost:8013
# Isi FKWEB_TOKEN dari freedom-finger.env. Hanya dipakai server ini; tidak pernah dikirim ke browser.
FREEDOM_FINGER_TOKEN=

# Port halaman web.
PORT=3000
# Folder aplikasi.json dan users.json (user dan hash kata sandi). Ikut di-backup.
DATA_DIR=./data
