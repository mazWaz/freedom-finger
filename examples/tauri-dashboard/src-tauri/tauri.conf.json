{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freedom Finger",
  "version": "0.2.0",
  "identifier": "io.github.mazwaz.freedom-finger-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Freedom Finger",
        "width": 1200,
        "height": 760,
        "visible": false,
        "minWidth": 900,
        "minHeight": 560,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Server absensi lokal dan dashboard untuk mesin Fingerspot",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCMDI0QTE4Q0IyMzA3ODgKUldTSUJ5UExHRW9DVzlyTWRNZ0M2WTIxVVZDQzVFUXdIL3p5Y2RlKzh3WGgyRHBZaVpZOGkweSsK",
      "endpoints": [
        "https://github.com/mazWaz/freedom-finger/releases/latest/download/latest.json"
      ]
    }
  }
}
