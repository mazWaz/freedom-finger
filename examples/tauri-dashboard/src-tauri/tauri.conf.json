{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freedom Finger Dashboard",
  "version": "0.1.0",
  "identifier": "io.github.mazwaz.freedom-finger-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Absen hari ini", "width": 720, "height": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
